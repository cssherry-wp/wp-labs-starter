#!/usr/bin/env bash
set -euo pipefail

HOOK="$(cd "$(dirname "$0")" && pwd)/check-claude-setup"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; exit 1; }

# --- Test 1: no queue dir -> silent, no error ---
LOCAL="$TMP/no_queue"
mkdir -p "$LOCAL"
out=$(CLAUDE_CONFIG_DIR="$LOCAL" bash "$HOOK" < /dev/null 2>&1) && rc=0 || rc=$?
if [ "$rc" -eq 0 ] && [ -z "$out" ]; then pass "no queue dir -> silent"
else fail "no queue dir -> expected silent exit 0, got rc=$rc out=$out"; fi

# --- Test 2: stale queue file (30+ days) archived to analytics dir; fresh one kept ---
LOCAL="$TMP/queue"
ANALYTICS="$TMP/queue-analytics"
mkdir -p "$LOCAL/queue" "$ANALYTICS"
printf 'stale\n' > "$LOCAL/queue/old.md"
printf 'fresh\n' > "$LOCAL/queue/new.md"
# Fixed far-past timestamp: portable across BSD (macOS) and GNU (Linux) touch,
# unlike `date -v-31d` which is BSD-only and errors on GNU coreutils.
touch -t 202001010000 "$LOCAL/queue/old.md"

CLAUDE_ANALYTICS_DIR="$ANALYTICS" CLAUDE_CONFIG_DIR="$LOCAL" bash "$HOOK" < /dev/null > /dev/null 2>&1 || true
if [ ! -e "$LOCAL/queue/old.md" ] && [ -f "$ANALYTICS/old.md" ] && [ -f "$LOCAL/queue/new.md" ]; then
  pass "stale queue archived to analytics dir, fresh kept"
else
  fail "queue cleanup -> expected old.md archived and new.md kept"
fi

# --- Test 3: CLAUDE_ANALYTICS_DIR unset -> archives to default location ---
LOCAL="$TMP/queue_default"
mkdir -p "$LOCAL/queue"
printf 'stale\n' > "$LOCAL/queue/old.md"
touch -t 202001010000 "$LOCAL/queue/old.md"
default_archive="$TMP/home/ClaudeAnalytics"
HOME="$TMP/home" CLAUDE_CONFIG_DIR="$LOCAL" bash "$HOOK" < /dev/null > /dev/null 2>&1 || true
if [ ! -e "$LOCAL/queue/old.md" ] && [ -f "$default_archive/old.md" ]; then
  pass "CLAUDE_ANALYTICS_DIR unset -> archives to ~/ClaudeAnalytics"
else
  fail "expected old.md archived to $default_archive"
fi

echo ""
echo "All tests passed."
