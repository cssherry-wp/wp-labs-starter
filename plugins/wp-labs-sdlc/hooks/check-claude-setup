#!/usr/bin/env bash
# Archive queue files untouched for >30 days to CLAUDE_ANALYTICS_DIR.
# Runs once at session start (SessionStart event); produces no output.
set -euo pipefail
cat > /dev/null  # consume session JSON sent by harness

_queue_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/queue"
[ -d "$_queue_dir" ] || exit 0

_archive_dir="${CLAUDE_ANALYTICS_DIR:-$HOME/ClaudeAnalytics}"
mkdir -p "$_archive_dir" 2>/dev/null || true

while IFS= read -r -d '' _qf; do
  mv "$_qf" "$_archive_dir/$(basename "$_qf")" 2>/dev/null || true
done < <(find "$_queue_dir" -maxdepth 1 -type f -name '*.md' -mtime +30 -print0 2>/dev/null)
