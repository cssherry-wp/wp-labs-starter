#!/usr/bin/env bash
# Shared check: any plugins/<name>/ changed since base-ref must land with a
# plugin.json version strictly greater than base-ref's, and wp-labs-sdlc's
# hardcoded SDLC_SOURCE_VERSION (in statusline.sh) must match its own
# plugin.json version. See CLAUDE.md "Plugin version bumps" /
# "wp-labs-sdlc: sync statusline.sh version".
#
# Usage: check-plugin-versions <base-ref> [new-ref]
#   base-ref: ref to compare against, e.g. origin/main
#   new-ref:  commit-ish holding the candidate state (CI: the PR head).
#             Omit to check the git index instead (local pre-commit usage).
set -uo pipefail

base_ref="${1:?usage: check-plugin-versions <base-ref> [new-ref]}"
new_ref="${2:-}"

git rev-parse --verify "$base_ref" >/dev/null 2>&1 || exit 0

diff_paths() { # path -> changed files between base_ref and new_ref (or index)
  if [ -z "$new_ref" ]; then
    git diff --cached --name-only "$base_ref" -- "$1" 2>/dev/null
  else
    git diff --name-only "$base_ref" "$new_ref" -- "$1" 2>/dev/null
  fi
}

content_at() { # path, ref (default new_ref) -> file content at that ref (or index if empty)
  git show "${2-$new_ref}:$1" 2>/dev/null
}

version_of() { # path, ref (default new_ref) -> version string or empty
  content_at "$1" "${2-$new_ref}" | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin).get('version', ''))
except Exception:
    pass
" 2>/dev/null
}

version_gt() { # new old -> exit 0 if new > old (numeric x.y.z, ignores any suffix)
  python3 -c "
import sys
def parts(v):
    out = []
    for p in v.split('.')[:3]:
        digits = ''.join(c for c in p if c.isdigit())
        out.append(int(digits) if digits else 0)
    return tuple(out)
sys.exit(0 if parts(sys.argv[1]) > parts(sys.argv[2]) else 1)
" "$1" "$2" 2>/dev/null
}

errors=()

for pj in plugins/*/.claude-plugin/plugin.json; do
  [ -f "$pj" ] || continue
  name=$(basename "$(dirname "$(dirname "$pj")")")
  changed=$(diff_paths "plugins/$name/")
  [ -z "$changed" ] && continue

  old_ver=$(version_of "$pj" "$base_ref")
  [ -z "$old_ver" ] && continue  # new plugin, nothing to compare against

  new_ver=$(version_of "$pj")
  if [ -z "$new_ver" ] || ! version_gt "$new_ver" "$old_ver"; then
    errors+=("plugins/$name changed but plugin.json version ($new_ver) is not greater than ${base_ref}'s ($old_ver)")
  fi
done

sdlc_pj="plugins/wp-labs-sdlc/.claude-plugin/plugin.json"
sdlc_sl="plugins/wp-labs-sdlc/skills/scaffolding-sdlc/templates/claude/statusline.sh"
if [ -f "$sdlc_pj" ] && [ -f "$sdlc_sl" ]; then
  pj_ver=$(version_of "$sdlc_pj")
  sl_ver=$(content_at "$sdlc_sl" | grep -o 'SDLC_SOURCE_VERSION="[^"]*"' | head -1 | sed -E 's/.*"([^"]*)"/\1/')
  if [ -n "$pj_ver" ] && [ -n "$sl_ver" ] && [ "$pj_ver" != "$sl_ver" ]; then
    errors+=("SDLC_SOURCE_VERSION in statusline.sh ($sl_ver) does not match wp-labs-sdlc plugin.json version ($pj_ver)")
  fi
fi

if [ "${#errors[@]}" -gt 0 ]; then
  {
    printf 'plugin version check failed:\n'
    printf ' - %s\n' "${errors[@]}"
  } >&2
  exit 1
fi
exit 0
